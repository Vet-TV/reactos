cwd=C:\Games
cmdline="C:\VetTV\dosbox-x\dosbox-x.exe" -conf "C:\temp\dosbox-x.conf" -exit -nopromptfolder -fastlaunch
--- conf ---
[sdl]
autolock=true
fullscreen=true
output=surface

[dosbox]
hostkey=mapper
machine=svga_s3
memsize=16
quit warning=false

[cpu]
cycles=max

[sblaster]
sbtype=sb16

[log]
